 {
  "id": "T1",
  "category": "tool_failure",
  "title": "Database unavailable",
  "context": {
   "user_name": "Prof Nunez",
   "user_role": "instructor"
  },
  "env": {
   "DATABASE_URL": "@bad_database"
  },
  "request": "List all students.",
  "expect": {
   "status": [
    "error"
   ],
   "reason_code": [
    "tool_failure"
